# WerkNL — copy this file to `.env` and fill in the values.

# 1) Bot token — create a bot at https://t.me/BotFather (/newbot) and paste the token here.
WERKNL_BOT_TOKEN=your_bot_token_here

# 2) Channel — create a Telegram channel, add your bot as ADMIN, then put its @username
#    (e.g. @werknl) or numeric id (e.g. -1001234567890) here.
WERKNL_CHANNEL_ID=@your_channel

# 3) Your own Telegram user id — get it from https://t.me/userinfobot
WERKNL_ADMIN_ID=123456789

# Optional — hour (0-23) the daily digest goes out.
WERKNL_DIGEST_HOUR=8
